# Double-click installer for Dataset Scout (v0.1.3 T23).
# The README promises "double-click Install Dataset Scout": this
# file is that promise. The Exec line must contain NO nested
# escaped quote: GLib rejects the whole file when it sees one. So
# the launcher is python3 -c with %k as a separate argv token:
# field-code expansion keeps a spaced path as one argument,
# dirname runs in Python, and install.sh runs through subprocess
# with a list. Some launchers expand %k to empty, so the code
# falls back to the working directory (which is the folder holding
# the installer in that case). Terminal=true: install.sh is a
# terminal script, and its progress and errors must stay visible.
[Desktop Entry]
Type=Application
Name=Install Dataset Scout
Comment=Install Dataset Scout on this PC
Exec=python3 -c "import os, sys, subprocess; a = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else ''; d = os.path.dirname(a) if a else os.getcwd(); subprocess.call(['bash', os.path.join(d, 'install.sh')])" %k
Terminal=true
Icon=system-software-install
Categories=Utility;
